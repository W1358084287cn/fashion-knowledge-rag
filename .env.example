# ============================================================
# 环境变量示例
# 复制为 .env 后按需修改（不复制也能以默认值运行）
# ============================================================

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=***
MYSQL_DB=fashion_cs

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=fashion_kb

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=***

# 管理员（固定账号密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=***

# 登录态
JWT_SECRET=***
JWT_EXPIRE_MINUTES=480

# 离线处理
# 上传文件保存目录：留空则默认 backend/uploads（建议直接用默认值，不要写成空键值）
# UPLOAD_DIR=
MAX_UPLOAD_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=80
MAX_CHUNKS_PER_FILE=300
OCR_MIN_CHARS_PER_PAGE=30

# 在线问答
# 注意：更换 Embedding 模型时必须同步修改维度，并重建 Qdrant 集合
EMBEDDING_DIM=1024
CACHE_TTL_SECONDS=600
CACHE_MAX_SIZE=200
TOP_K_EACH=20
TOP_K_FINAL=5
LLM_TIMEOUT_SECONDS=90
